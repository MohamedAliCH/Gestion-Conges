<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-creation-table-employes" author="dali">
        <createTable tableName="employes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="prenom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="cin" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATE"/>
            <column name="first_login" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>
    </changeSet>

    <changeSet id="002-insert-default-users" author="dali">
        <!-- Admin par défaut (mot de passe : admin123) -->
        <insert tableName="employes">
            <column name="prenom" value="Admin"/>
            <column name="nom" value="Systeme"/>
            <column name="email" value="admin@intraspace.com"/>
            <column name="cin" value="00000000"/>
            <column name="password" value="$2a$10$dltjXgCxivB2DWhxx9LOHuo36Y738oYQZ2N6qNzuO.k/GM80CNxYe"/>
            <column name="role" value="ROLE_ADMIN"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueDate="2026-06-17"/>
            <column name="first_login" valueBoolean="false"/>
        </insert>
        <!-- Employé par défaut (mot de passe : admin123, premier login = true) -->
        <insert tableName="employes">
            <column name="prenom" value="John"/>
            <column name="nom" value="Doe"/>
            <column name="email" value="employe@intraspace.com"/>
            <column name="cin" value="11111111"/>
            <column name="password" value="$2a$10$dltjXgCxivB2DWhxx9LOHuo36Y738oYQZ2N6qNzuO.k/GM80CNxYe"/>
            <column name="role" value="ROLE_EMPLOYE"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" valueDate="2026-06-17"/>
            <column name="first_login" valueBoolean="true"/>
        </insert>
    </changeSet>
    
    <changeSet id="003-profile-and-leaves-tables" author="dali">
        <!-- Add phone and address to employes table -->
        <addColumn tableName="employes">
            <column name="phone" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
        </addColumn>

        <!-- Create conges table -->
        <createTable tableName="conges">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employe_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_conges_employes" referencedTableName="employes" referencedColumnNames="id"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date_debut" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_fin" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="days" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(1000)"/>
        </createTable>

        <!-- Insert mock leaves history for default employe (email: employe@intraspace.com, id: 2) -->
        <insert tableName="conges">
            <column name="employe_id" valueNumeric="2"/>
            <column name="type" value="Congé Annuel"/>
            <column name="date_debut" valueDate="2026-04-01"/>
            <column name="date_fin" valueDate="2026-04-12"/>
            <column name="days" valueNumeric="12"/>
            <column name="status" value="Approuvé"/>
        </insert>
        <insert tableName="conges">
            <column name="employe_id" valueNumeric="2"/>
            <column name="type" value="Congé Maladie"/>
            <column name="date_debut" valueDate="2026-05-01"/>
            <column name="date_fin" valueDate="2026-05-02"/>
            <column name="days" valueNumeric="2"/>
            <column name="status" value="Approuvé"/>
        </insert>
        <insert tableName="conges">
            <column name="employe_id" valueNumeric="2"/>
            <column name="type" value="Congé Annuel"/>
            <column name="date_debut" valueDate="2026-06-20"/>
            <column name="date_fin" valueDate="2026-06-20"/>
            <column name="days" valueNumeric="1"/>
            <column name="status" value="En attente"/>
        </insert>

        <!-- Update mock employee's phone and address -->
        <update tableName="employes">
            <column name="phone" value="+216 55 123 456"/>
            <column name="address" value="123 Avenue Habib Bourguiba, Tunis"/>
            <where>id = 2</where>
        </update>
    </changeSet>

    <changeSet id="004-add-refus-motif" author="antigravity">
        <addColumn tableName="conges">
            <column name="refus_motif" type="VARCHAR(1000)"/>
        </addColumn>
    </changeSet>

    <changeSet id="005-documents-rag" author="ai">
        <!-- pgvector extension (must be installed in PostgreSQL: CREATE EXTENSION vector) -->
        <sql>CREATE EXTENSION IF NOT EXISTS vector;</sql>

        <!-- Document metadata table -->
        <createTable tableName="documents_rh">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="chemin_fichier" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="type_mime" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="taille" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="date_upload" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="uploade_par" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="statut" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="erreur" type="TEXT"/>
        </createTable>

        <!-- Text chunks table -->
        <createTable tableName="document_chunks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_chunk_document"
                             referencedTableName="documents_rh"
                             referencedColumnNames="id"/>
            </column>
            <column name="contenu" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="chunk_index" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- pgvector column — requires the vector extension -->
        <sql>ALTER TABLE document_chunks ADD COLUMN IF NOT EXISTS embedding vector(768);</sql>

        <!-- Index for fast similarity search -->
        <sql>CREATE INDEX IF NOT EXISTS idx_chunks_embedding ON document_chunks USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);</sql>
    </changeSet>

    <changeSet id="006-chatbot-access-role" author="ai">
        <!-- Contrôle d'accès RAG : ROLE_ADMIN ou ROLE_EMPLOYE -->
        <addColumn tableName="document_chunks">
            <column name="access_role" type="VARCHAR(50)" defaultValue="ROLE_ADMIN">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Historique des conversations du chatbot admin (isolé par email) -->
        <createTable tableName="chatbot_conversations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="question" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="sql_generated" type="TEXT"/>
            <column name="response" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="chatbot_conversations" indexName="idx_chatbot_user_email">
            <column name="user_email"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>